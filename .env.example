# Скопируй в .env и подставь свой ключ:  cp .env.example .env
# .env в git не попадает (см. .gitignore)

# Ключ DeepSeek: https://platform.deepseek.com/api_keys
# НИКОГДА не коммитить и не показывать на видео.
DEEPSEEK_API_KEY=sk-...

# Модель: deepseek-chat (V3, быстрая) или deepseek-reasoner (R1, с рассуждениями)
DEEPSEEK_MODEL=deepseek-chat

# База API. Менять не нужно.
DEEPSEEK_BASE_URL=https://api.deepseek.com
